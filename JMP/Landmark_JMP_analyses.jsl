// ============================================================
// LANDMARK-LEARNING EXPERIMENT — REPRODUCIBILITY SCRIPT
//
// Expected repository structure:
//   JMP/Landmark_JMP_analyses.jsl
//   data/LandmarkLearning_Main.jmp
//   data/LandmarkLearning_InterTrialIntervals.jmp
//
// Open this saved script from the repository JMP folder.
// The data tables are opened automatically from the sibling data folder.
// ============================================================

scriptDir = Get Default Directory();
dataDir = scriptDir || "../data/";

dtMain = Open(dataDir || "LandmarkLearning_Main.jmp");
dtITI = Open(dataDir || "LandmarkLearning_InterTrialIntervals.jmp");

﻿// ============================================================
// 1. INTER-TRIAL INTERVAL
// Landmark-learning experiment
//
// Response: log10 inter-trial interval
// N = 630 measured intervals
// ============================================================

// dtITI opened above from repository data folder

// Create log10-transformed response if it does not already exist
If(
    Is Empty(
        Try(Column(dtITI, "Log10_Gap_after_trial_min"), Empty())
    ),
    dtITI << New Column(
        "Log10_Gap_after_trial_min",
        Numeric,
        Continuous,
        Formula(Log10(:Gap_after_trial_min))
    )
);

dtITI << Fit Model(
    Y(:Log10_Gap_after_trial_min),
    Effects(
        :Treatment,
        :Trial,
        :Trial * :Treatment
    ),
    Random Effects(
        :Colony[:Treatment],
        :Bee[:Colony]
    ),
    NoBounds(1),
    Personality("Mixed Model"),
    Subject(:Bee),
    Repeated Effects(:Trial),
    Repeated Structure("AR(1)"),
    Run(Variogram(AR1(1)))
);

// ============================================================
// 2. NUMBER OF FEEDER VISITS
// Landmark-learning experiment, Fig. 7a
//
// Response: log10 number of feeder visits
// N = 720 observations (90 bees x 8 trials)
// ============================================================

// dtMain opened above from repository data folder

// Create log10-transformed response
If(
    Is Empty(
        Try(Column(dtMain, "Log10_NumberFeederVisits"), Empty())
    ),
    dtMain << New Column(
        "Log10_NumberFeederVisits",
        Numeric,
        Continuous,
        Formula(Log10(:NumberFeederVisits))
    )
);

// Repeated-measures mixed model
dtMain << Fit Model(
    Y(:Log10_NumberFeederVisits),
    Effects(
        :Treatment,
        :Trial,
        :Trial * :Treatment
    ),
    Random Effects(
        :hive[:Treatment],
        :bee[:hive]
    ),
    NoBounds(1),
    Personality("Mixed Model"),
    Subject(:bee),
    Repeated Effects(:Trial),
    Repeated Structure("AR(1)"),
    Run(
        Multiple Comparisons(
            Effect(:Treatment),
            Least Squares Means Plot,
            Tukey HSD(1)
        ),
        Variogram(AR1(1))
    )
);

// ============================================================
// 3. NUMBER OF FEEDER VISITS — AGE COVARIATE
// Sensitivity analysis including bee age relative to the
// mean age of bees from the same colony.
// ============================================================

dtMain << Fit Model(
    Y(:Log10_NumberFeederVisits),
    Effects(
        :Treatment,
        :Trial,
        :Trial * :Treatment,
        :Age_rel_colony
    ),
    Random Effects(
        :hive[:Treatment],
        :bee[:hive]
    ),
    NoBounds(1),
    Personality("Mixed Model"),
    Subject(:bee),
    Repeated Effects(:Trial),
    Repeated Structure("AR(1)"),
    Run(Variogram(AR1(1)))
);

// ============================================================
// 3. TIME TO FINISH
// Landmark-learning experiment, Fig. 7b
//
// Response: log10 time to finish (seconds)
// ============================================================

// dtMain opened above from repository data folder

// Ensure no exclusions from previous analyses remain
dtMain << Clear Row States;

// Create log10-transformed response
If(
    Is Empty(
        Try(Column(dtMain, "Log10_TimeToFinish"), Empty())
    ),
    dtMain << New Column(
        "Log10_TimeToFinish",
        Numeric,
        Continuous,
        Formula(Log10(:Name("Time to finish (sec)")))
    )
);

// Repeated-measures mixed model
dtMain << Fit Model(
    Y(:Log10_TimeToFinish),
    Effects(
        :Treatment,
        :Trial,
        :Trial * :Treatment
    ),
    Random Effects(
        :hive[:Treatment],
        :bee[:hive]
    ),
    NoBounds(1),
    Personality("Mixed Model"),
    Subject(:bee),
    Repeated Effects(:Trial),
    Repeated Structure("AR(1)"),
    Run(Variogram(AR1(1)))
);

// ============================================================
// 3. DISTANCE FLOWN TO FINISH
// Landmark-learning experiment, Fig. 7c
//
// Response: log10 distance flown (cm)
// ============================================================

// dtMain opened above from repository data folder

// Ensure no exclusions from previous analyses remain
dtMain << Clear Row States;

// Create log10-transformed response
If(
    Is Empty(
        Try(Column(dtMain, "Log10_Distance"), Empty())
    ),
    dtMain << New Column(
        "Log10_Distance",
        Numeric,
        Continuous,
        Formula(Log10(:Name("Distance (cm)")))
    )
);

// Repeated-measures mixed model
dtMain << Fit Model(
    Y(:Log10_Distance),
    Effects(
        :Treatment,
        :Trial,
        :Trial * :Treatment
    ),
    Random Effects(
        :hive[:Treatment],
        :bee[:hive]
    ),
    NoBounds(1),
    Personality("Mixed Model"),
    Subject(:bee),
    Repeated Effects(:Trial),
    Repeated Structure("AR(1)"),
    Run(Variogram(AR1(1)))
);

// ============================================================
// 3. OVERALL PERFORMANCE ACROSS TRIALS
// Landmark-learning experiment, Fig. 7d
//
// Bees were ranked by completion time within each trial.
// The eight within-trial ranks were averaged for each bee.
// Mean ranks were compared among treatments using
// Kruskal-Wallis and Steel-Dwass tests.
// ============================================================

// dtMain opened above from repository data folder

dtMain << Clear Row States;

// Create within-trial completion-time ranks
If(
    Is Empty(
        Try(Column(dtMain, "RankWithinTrial"), Empty())
    ),
    dtMain << New Column(
        "RankWithinTrial",
        Numeric,
        Continuous,
        Formula(
            Col Rank(:Name("Time to finish (sec)"), :Trial)
        )
    )
);

// Sum the eight ranks for each bee
If(
    Is Empty(
        Try(Column(dtMain, "TotalRank8Trials"), Empty())
    ),
    dtMain << New Column(
        "TotalRank8Trials",
        Numeric,
        Continuous,
        Formula(
            Col Sum(:RankWithinTrial, :bee)
        )
    )
);

// Mean rank across the eight trials
If(
    Is Empty(
        Try(Column(dtMain, "MeanRank8Trials"), Empty())
    ),
    dtMain << New Column(
        "MeanRank8Trials",
        Numeric,
        Continuous,
        Formula(
            :TotalRank8Trials / 8
        )
    )
);

// One row per bee
dtBeeRank = dtMain << Summary(
    Group(
        :Treatment,
        :hive,
        :bee,
        :MeanRank8Trials
    ),
    Output Table("Landmark mean ranks")
);

// Compare mean ranks among treatments using
// Kruskal-Wallis and Steel-Dwass all-pairs comparisons
dtBeeRank << Oneway(
    Y(:MeanRank8Trials),
    X(:Treatment),
    Wilcoxon(1),
    "Steel-Dwass All Pairs"n(1)
);

// ============================================================
// 3. FEEDER APPROACH DIRECTION
// Landmark-learning experiment, Fig. 8b
//
// Approach angle was measured 35 cm from the feeder.
// Angles <43 degrees were classified as center approaches;
// angles >=43 degrees were classified as side approaches.
// Response analyzed with a binomial GLMM.
// ============================================================

// dtMain opened above from repository data folder

dtMain << Clear Row States;

// Create center/side classification
If(
    Is Empty(
        Try(Column(dtMain, "ApproachDirection"), Empty())
    ),
    dtMain << New Column(
        "ApproachDirection",
        Character,
        Nominal,
        Formula(
            If(
                Is Missing(:Name("angle from the middle (35 cm)")),
                "",
                :Name("angle from the middle (35 cm)") < 43,
                "center",
                "side"
            )
        )
    )
);

// Binomial GLMM
dtMain << Fit Model(
    Y(:ApproachDirection),
    Effects(
        :Treatment,
        :Trial,
        :Treatment * :Trial
    ),
    Random Effects(
        :hive[:Treatment],
        :bee[:hive]
    ),
    NoBounds(1),
    Target Level("side"),
    Personality("Generalized Linear Mixed Model"),
    Subject(:bee),
    Repeated Effects(:Trial),
    Repeated Structure("AR(1)"),
    Generalized Distribution("Binomial"),
    Link Function("Logit"),
    Run(Fit)
);


// ============================================================
// FIG. 8c. EARLY VS LATE CENTER APPROACHES
//
// Trials 1-4 = Early; Trials 5-8 = Late.
// Center approach = approach angle <43 degrees at 35 cm.
// For each bee, the number of center approaches is summed
// separately over the four Early and four Late trials.
// ============================================================

// dtMain opened above from repository data folder

dtMain << Clear Row States;

// Create phase
If(
	Is Empty(Try(Column(dtMain, "Phase"), Empty())),
	dtMain << New Column(
		"Phase",
		Character,
		Nominal,
		Formula(
			If(:Trial <= 4, "Early", "Late")
		)
	)
);

// Create binary center-approach variable from raw approach angle
If(
	Is Empty(Try(Column(dtMain, "CenterApproach"), Empty())),
	dtMain << New Column(
		"CenterApproach",
		Numeric,
		Continuous,
		Formula(
			If(
				Is Missing(:"angle from the middle (35 cm)"n),
				.,
				:"angle from the middle (35 cm)"n < 43,
				1,
				0
			)
		)
	)
);

// Sum center approaches separately for Early and Late trials
dtPhase = dtMain << Summary(
	Group(
		:Treatment,
		:hive,
		:bee,
		:Phase
	),
	Sum(:CenterApproach),
	Output Table("Landmark Early Late center approaches")
);

// Mixed model and Tukey comparisons
dtPhase << Fit Model(
	Y(:"Sum(CenterApproach)"n),
	Effects(:Phase, :Treatment, :Phase * :Treatment),
	Random Effects(:hive[:Treatment], :bee[:hive]),
	NoBounds(1),
	Personality("Mixed Model"),
	Run(
		Repeated Effects Covariance Parameter Estimates(0),
		Multiple Comparisons(
			Effect(:Phase * :Treatment),
			Least Squares Means Plot(No Overlay Terms),
			Tukey HSD(1)
		)
	)
);